# The Obsidian vault over WebDAV (src/aide/webdav.py), next to the Aide service. Install: see README.md, "Obsidian".
[Unit]
Description=Aide vault over WebDAV
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/Developer/aide
ExecStart=%h/Developer/aide/.venv/bin/python -m aide.webdav
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
