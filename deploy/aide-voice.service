# A live call's voice (Chatterbox, deploy/chatterbox/server.py) on 127.0.0.1:8766, next to the Aide service, which
# falls back to Kokoro while it's not there. Install: see README.md, "Live calls".
[Unit]
Description=Aide call voice (Chatterbox)
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
Slice=aide.slice
WorkingDirectory=%h/Developer/aide
ExecStart=%h/Developer/aide/deploy/chatterbox/.venv/bin/python deploy/chatterbox/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
