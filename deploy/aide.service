# Install: see README.md, "Running as a service".
[Unit]
Description=Aide personal assistant
Wants=network-online.target
After=network-online.target
# Give up restarting only after 10 failures in 10 minutes.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=aide
Group=aide
WorkingDirectory=/opt/aide
EnvironmentFile=/etc/aide/aide.env
Environment=AIDE_DB_PATH=/var/lib/aide/aide.db
ExecStart=/opt/aide/.venv/bin/aide
Restart=always
RestartSec=5

# State lives in /var/lib/aide; everything else is read-only to the service.
StateDirectory=aide
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
