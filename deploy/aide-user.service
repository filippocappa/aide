# User-level service: runs from the checkout, reads .env there, no root needed.
# Install: see README.md, "Running as a service".
[Unit]
Description=Aide personal assistant
# Give up restarting only after 10 failures in 10 minutes.
StartLimitIntervalSec=600
StartLimitBurst=10
# The browser's screen (deploy/aide-xvfb.service); without it the browser runs headless.
Wants=aide-xvfb.service
After=aide-xvfb.service

[Service]
Type=simple
# Aide and its voice share one memory budget (aide.slice), so loading the models can't take cappa down with them.
Slice=aide.slice
# Temporary files on disk: /tmp is RAM on cappa, and Parakeet unpacks 2.5 GB there while it loads.
Environment=TMPDIR=%h/.cache/aide/tmp
Environment=DISPLAY=:99
ExecStartPre=/bin/sh -c 'rm -rf %h/.cache/aide/tmp; mkdir -p %h/.cache/aide/tmp'
WorkingDirectory=%h/Developer/aide
ExecStart=%h/Developer/aide/.venv/bin/aide
Restart=always
RestartSec=5
# Wait for the network on boot; Restart= covers the rare case it's still not up.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do getent hosts openrouter.ai >/dev/null && exit 0; sleep 2; done; exit 0'

[Install]
WantedBy=default.target
