# Copy to .env for local runs. In production the systemd unit reads /etc/aide/aide.env.
# Set one of these. OpenRouter wins if both are set.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DISCORD_TOKEN=
# Your own Discord user ID (Developer Mode -> right-click your name -> Copy User ID).
DISCORD_OWNER_ID=

AIDE_TIMEZONE=Europe/Rome
AIDE_DB_PATH=./data/aide.db
# Leave empty for the defaults: Haiku 5.5 for everyday use, Sonnet 5.5 after !think.
AIDE_MODEL=
AIDE_SMART_MODEL=
AIDE_EFFORT=medium
# A new conversation starts after this many hours of silence (or with !new).
AIDE_IDLE_HOURS=6
