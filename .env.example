# Copy to .env and fill in. The server reads .env from the checkout it runs in (deploy/aide-user.service).
# Set one of these. OpenRouter wins if both are set.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

AIDE_TIMEZONE=Europe/Rome
AIDE_DB_PATH=./data/aide.db
# Leave empty for the defaults: Haiku 5.5 for everyday use, Sonnet 5.5 after "think harder" in the app.
AIDE_MODEL=
AIDE_SMART_MODEL=
AIDE_EFFORT=medium
# A new conversation starts after this many hours of silence.
AIDE_IDLE_HOURS=6

# iCloud Calendar. App-specific password from account.apple.com -> Sign-In and Security.
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=
# Calendar new events go to when you don't name one (default: the first iCloud calendar).
AIDE_DEFAULT_CALENDAR=

# HTTP API for the iOS app (listens on 127.0.0.1 only; published to your tailnet with `tailscale serve`).
# Generate a token with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIDE_API_TOKEN=
AIDE_API_PORT=8787

# Gmail. OAuth client from Google Cloud (type "Desktop app"); see README.md, "Gmail".
# Then run `uv run python -m aide.gmail_auth` once: it fills in GMAIL_REFRESH_TOKEN.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Web search (Tavily, free tier 1,000 searches a month). See README.md, "Web search and Maps".
TAVILY_API_KEY=
# Google Maps (Places API (New) and Routes API). See README.md, "Web search and Maps".
GOOGLE_MAPS_API_KEY=
# Where "near me" and travel times start from, unless you tell Aide a different home.
AIDE_HOME_ADDRESS=

# Push notifications (APNs). See README.md, "Push notifications". Leave the key empty: no pushes.
# Keep the .p8 outside the repo, e.g. ~/.config/aide/AuthKey_XXXXXXXXXX.p8 (chmod 600).
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
# The app's bundle id: AIDE_BUNDLE_ID in ios/Aide/Config (Base.xcconfig, or yours in Signing.local.xcconfig).
APNS_BUNDLE_ID=com.filippocappa.aide

# Voice chat: transcribed through OpenRouter (off without an OpenRouter key).
AIDE_TRANSCRIBE_MODEL=

# Study (Professor). Courses are the event titles that repeat in this calendar; exams come from the second.
AIDE_STUDY_CALENDAR=Work
AIDE_EXAM_CALENDAR=Exam
# Study-calendar titles that aren't courses (your own study blocks), comma-separated.
AIDE_STUDY_SKIP=study
# Lecture transcription on an NVIDIA GPU (uv sync --extra whisper). Empty: large-v3-turbo.
AIDE_WHISPER_MODEL=

# Moodle (any site with the mobile app enabled). See README.md, "Moodle". Log in from the app; the server
# writes MOODLE_TOKEN here itself.
AIDE_MOODLE_URL=
MOODLE_TOKEN=

# The Obsidian vault over WebDAV. See README.md, "Obsidian". No password: no vault.
AIDE_WEBDAV_PASSWORD=
AIDE_WEBDAV_URL=
AIDE_WEBDAV_PORT=8789
AIDE_VAULT_NAME=Uni
AIDE_VAULT_DIR=./data/obsidian

# Nightly backups (deploy/aide-backup.timer). Empty: ~/aide-backups.
AIDE_BACKUP_DIR=
