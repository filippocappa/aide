// Copy to Signing.local.xcconfig and put in the paid team's ID
// (developer.apple.com > Account > Membership details > Team ID).
DEVELOPMENT_TEAM = XXXXXXXXXX

// Your own bundle ID, if you're not on the owner's team (a bundle ID belongs to one team). Set APNS_BUNDLE_ID in the
// server's .env to the same.
// AIDE_BUNDLE_ID = com.example.aide

// Push notifications (docs/API.md, Push), plus Apple Health, Screen Time and the App Group. Only with the paid
// team; leave it out for a Personal Team (then Config/Base.xcconfig's Default.entitlements: no push). If a Personal
// Team won't sign Health or Screen Time either, use only the App Group, so the widgets keep the keychain:
// AIDE_ENTITLEMENTS = Aide/AppGroup.entitlements
AIDE_ENTITLEMENTS = Aide/Aide.entitlements

// Push to the Mac app too (docs/API.md, Push: `app` "mac"). Same rule: only with the paid team.
AIDE_MAC_ENTITLEMENTS = Mac/AideMacPush.entitlements
