<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A Personal Team that won't sign Health or Screen Time: only the App Group, so the widgets and the share
	     extension still read the server and token from the keychain (Config/Signing.local.xcconfig.example). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(AIDE_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
