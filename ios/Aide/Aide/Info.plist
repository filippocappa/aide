<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AideAppGroup</key>
	<string>group.$(AIDE_BUNDLE_ID)</string>
	<key>AideKeychainService</key>
	<string>$(AIDE_BUNDLE_ID)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Aide</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(AIDE_BUNDLE_ID)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aide</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Aide uses the camera when you take a photo to send, like a meal to log.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Aide reads your sleep, heart rate, HRV, steps and workouts to write your wake-up briefing and tick off workout habits.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Aide writes the coffees you log through it to Inhaler Usage, so you don't have to log them twice.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>With Always, tram alerts know the walk to the stop with the app closed. Aide sends your location only when you move about 500 m or an alert is about to fire.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Aide sends where you are to your server, so a tram alert knows how long the walk to the stop is.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Aide listens when you tap the microphone, so you can talk instead of type.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Aide mirrors your reminders into a list in Apple Reminders so your phone can notify you.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Aide turns what you say into text to send to your assistant.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
